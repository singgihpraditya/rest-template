<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <!--
            Format: timestamp | level | thread | logger | traceId | pesan
            %X{traceId:-NO_TRACE} → tampilkan "NO_TRACE" jika traceId tidak ada di MDC.
            traceId hanya terisi pada log yang berasal dari HTTP request (diisi oleh TraceIdLoggingFilter).
            Log saat startup atau background job tidak punya traceId aktif.
        -->
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | %thread | %logger{36} | traceId=%X{traceId:-NO_TRACE} | %msg%n</Property>
        <Property name="LOG_FILE">logs/app.log</Property>
        <Property name="LOG_ARCHIVE">logs/app-%d{yyyy-MM-dd}-%i.log.gz</Property>
    </Properties>

    <Appenders>

        <!-- Console Appender: output ke terminal -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <!-- Rolling File Appender: output ke file, rotate harian + size, simpan 30 hari -->
        <RollingFile name="RollingFile"
                     fileName="${LOG_FILE}"
                     filePattern="${LOG_ARCHIVE}">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <!-- Rotate setiap hari -->
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <!-- Rotate jika file melebihi 10MB -->
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <!-- Hapus file log yang lebih lama dari 30 hari -->
                <Delete basePath="logs" maxDepth="1">
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

    </Appenders>

    <Loggers>

        <!-- Logger khusus untuk package aplikasi: DEBUG level -->
        <Logger name="com.example.template" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- Logger untuk Feign client: DEBUG untuk melihat request/response -->
        <Logger name="feign" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- Root logger: semua framework lain pada level INFO -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Root>

    </Loggers>

</Configuration>
