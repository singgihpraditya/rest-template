{
  "info": {
    "_postman_id": "rest-template-api-collection",
    "name": "REST Template API",
    "description": "Postman Collection untuk REST Template API - Spring Boot 3.2 + JWT\n\n**Setup:**\n1. Jalankan aplikasi dengan profile local: `mvn spring-boot:run -Dspring-boot.run.profiles=local`\n2. Import collection ini ke Postman\n3. Jalankan request **Login** di folder Auth - token akan otomatis tersimpan ke variable `token`\n4. Semua request lain sudah dikonfigurasi menggunakan token tersebut\n\n**Default credentials:**\n- Admin: `admin / admin123`\n- User: `user / user123`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Base URL aplikasi"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token - otomatis terisi setelah request Login"
    },
    {
      "key": "new_permission_id",
      "value": "",
      "type": "string",
      "description": "ID permission rule - otomatis terisi setelah request Tambah Rule Baru"
    },
    {
      "key": "uploaded_filename",
      "value": "",
      "type": "string",
      "description": "Nama file - otomatis terisi setelah request Upload File"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Endpoint autentikasi: login, register, dan get current user",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const token = json.output_schema.access_token;",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('Token tersimpan:', token.substring(0, 30) + '...');",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Error code RST-000', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.error_schema.error_code).to.eql('RST-000');",
                  "});",
                  "pm.test('Token ada', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.output_schema.access_token).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login sebagai admin. Token JWT akan otomatis tersimpan ke variable `token`."
          }
        },
        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.output_schema.access_token);",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"user123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login sebagai regular user."
          }
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Error code RST-000', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.error_schema.error_code).to.eql('RST-000');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"newpass123\",\n  \"email\": \"newuser@example.com\",\n  \"fullName\": \"New User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Daftarkan user baru. Role default: ROLE_USER."
          }
        },
        {
          "name": "Get Current User (Me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Username ada', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.output_schema.username).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Ambil data user yang sedang login. Membutuhkan token JWT."
          }
        },
        {
          "name": "Login - Validation Error",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code RST-001', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.error_schema.error_code).to.eql('RST-001');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Contoh response validation error (RST-001) saat field kosong."
          }
        }
      ]
    },
