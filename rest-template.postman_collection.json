                  "pm.test('filename dan file_url ada', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.output_schema.filename).to.be.a('string');",
                  "    pm.expect(json.output_schema.file_url).to.be.a('string');",
                  "    pm.collectionVariables.set('uploaded_filename', json.output_schema.filename);",
                  "});"
